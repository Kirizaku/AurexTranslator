{
  "name": "Русский TTS",
  "lang": "ru",
  "version": 1,
  "rules": [
    { "regex": true,  "source": "Speech", "from": "(\\d)\\s*[xх×]\\s*(\\d)", "to": "\\1 на \\2" },
    { "regex": true,  "source": "Speech", "from": "(?<![\\wа-яА-Я\\d])\\+(\\d)", "to": "плюс \\1" },
    { "regex": true,  "source": "Speech", "from": "(?<![\\wа-яА-Я\\d])[-−](\\d)", "to": "минус \\1" },

    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*%", "to": "\\1 процент" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*%", "to": "\\1 процента" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*%", "to": "\\1 процентов" },

    { "regex": true,  "source": "Speech", "from": "\\$\\s*(\\d*[02-9]1|1)\\b", "to": "\\1 доллар" },
    { "regex": true,  "source": "Speech", "from": "\\$\\s*(\\d*[02-9][2-4]|[2-4])\\b", "to": "\\1 доллара" },
    { "regex": true,  "source": "Speech", "from": "\\$\\s*(\\d+)", "to": "\\1 долларов" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*\\$", "to": "\\1 доллар" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*\\$", "to": "\\1 доллара" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*\\$", "to": "\\1 долларов" },

    { "regex": true,  "source": "Speech", "from": "€\\s*(\\d+)", "to": "\\1 евро" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*€", "to": "\\1 евро" },

    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*₽", "to": "\\1 рубль" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*₽", "to": "\\1 рубля" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*₽", "to": "\\1 рублей" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*руб\\.", "to": "\\1 рубль" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*руб\\.", "to": "\\1 рубля" },
    { "regex": true,  "source": "Speech", "from": "руб\\.", "to": "рублей" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*коп\\.", "to": "\\1 копейка" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*коп\\.", "to": "\\1 копейки" },
    { "regex": true,  "source": "Speech", "from": "коп\\.", "to": "копеек" },

    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*°\\s*C(?![A-Za-zА-Яа-я])", "to": "\\1 градус Цельсия" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*°\\s*C(?![A-Za-zА-Яа-я])", "to": "\\1 градуса Цельсия" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*°\\s*C(?![A-Za-zА-Яа-я])", "to": "\\1 градусов Цельсия" },
    { "regex": true,  "source": "Speech", "from": "°\\s*C(?![A-Za-zА-Яа-я])", "to": " градусов Цельсия" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*°\\s*F(?![A-Za-zА-Яа-я])", "to": "\\1 градус Фаренгейта" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*°\\s*F(?![A-Za-zА-Яа-я])", "to": "\\1 градуса Фаренгейта" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*°\\s*F(?![A-Za-zА-Яа-я])", "to": "\\1 градусов Фаренгейта" },
    { "regex": true,  "source": "Speech", "from": "°\\s*F(?![A-Za-zА-Яа-я])", "to": " градусов Фаренгейта" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*°", "to": "\\1 градус" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*°", "to": "\\1 градуса" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*°", "to": "\\1 градусов" },
    { "regex": true,  "source": "Speech", "from": "°", "to": " градусов" },

    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*км/ч(?![а-яА-Я])", "to": "\\1 километр в час" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*км/ч(?![а-яА-Я])", "to": "\\1 километра в час" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*км/ч(?![а-яА-Я])", "to": "\\1 километров в час" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*км(?![а-яА-Я])", "to": "\\1 километр" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*км(?![а-яА-Я])", "to": "\\1 километра" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*км(?![а-яА-Я])", "to": "\\1 километров" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*кг(?![а-яА-Я])", "to": "\\1 килограмм" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*кг(?![а-яА-Я])", "to": "\\1 килограмма" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*кг(?![а-яА-Я])", "to": "\\1 килограммов" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*см(?![а-яА-Я])", "to": "\\1 сантиметр" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*см(?![а-яА-Я])", "to": "\\1 сантиметра" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*см(?![а-яА-Я])", "to": "\\1 сантиметров" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*мм(?![а-яА-Я])", "to": "\\1 миллиметр" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*мм(?![а-яА-Я])", "to": "\\1 миллиметра" },
    { "regex": true,  "source": "Speech", "from": "(\\d+)\\s*мм(?![а-яА-Я])", "to": "\\1 миллиметров" },

    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*тыс\\.", "to": "\\1 тысяча" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*тыс\\.", "to": "\\1 тысячи" },
    { "regex": true,  "source": "Speech", "from": "тыс\\.", "to": "тысяч " },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*млн(?![а-яА-Я])", "to": "\\1 миллион" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*млн(?![а-яА-Я])", "to": "\\1 миллиона" },
    { "regex": true,  "source": "Speech", "from": "млн(?![а-яА-Я])", "to": "миллионов" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9]1|1)\\s*млрд(?![а-яА-Я])", "to": "\\1 миллиард" },
    { "regex": true,  "source": "Speech", "from": "\\b(\\d*[02-9][2-4]|[2-4])\\s*млрд(?![а-яА-Я])", "to": "\\1 миллиарда" },
    { "regex": true,  "source": "Speech", "from": "млрд(?![а-яА-Я])", "to": "миллиардов" },

    { "regex": false, "source": "Speech", "from": "№", "to": "номер " },
    { "regex": true,  "source": "Speech", "from": "\\s&\\s", "to": " и " },
    { "regex": true,  "source": "Speech", "from": "т\\.\\s*д\\.", "to": "так далее" },
    { "regex": true,  "source": "Speech", "from": "т\\.\\s*п\\.", "to": "тому подобное" },
    { "regex": true,  "source": "Speech", "from": "т\\.\\s*е\\.", "to": "то есть" },
    { "regex": true,  "source": "Speech", "from": "т\\.\\s*к\\.", "to": "так как" },
    { "regex": true,  "source": "Speech", "from": "и\\s*др\\.", "to": "и другие" },
    { "regex": true,  "source": "Speech", "from": "см\\.", "to": "смотри " },
    { "regex": true,  "source": "Speech", "from": "стр\\.", "to": "страница " },
    { "regex": true,  "source": "Speech", "from": "(?i)\\bok\\b", "to": "окей" },

    { "regex": true,  "source": "Speech", "from": "\\.{2,}", "to": "." },
    { "regex": true,  "source": "Speech", "from": "\\s[—–]\\s", "to": ", " },
    { "regex": true,  "source": "Speech", "from": "\\s+([,.!?])", "to": "\\1" },
    { "regex": true,  "source": "Speech", "from": "\\s{2,}", "to": " " },
    { "regex": true,  "source": "Speech", "from": "^\\s+|\\s+$", "to": "" }
  ]
}
