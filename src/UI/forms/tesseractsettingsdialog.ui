<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TesseractSettingsDialog</class>
 <widget class="QDialog" name="TesseractSettingsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>460</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string notr="true">Tesseract</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout" stretch="1,0">
   <item>
    <widget class="QSplitter" name="splitter">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <widget class="QWidget" name="settingsPage">
      <layout class="QVBoxLayout" name="settingsLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>6</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <layout class="QFormLayout" name="formLayout">
         <property name="fieldGrowthPolicy">
          <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
         </property>
         <item row="0" column="0">
          <widget class="QLabel" name="statusTitleLabel">
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Status</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLabel" name="statusLabel"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="languageLabel">
         <property name="buddy">
          <cstring>languageComboBox</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Language</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <layout class="QHBoxLayout" name="languageLayout" stretch="1,0">
           <item>
            <widget class="QComboBox" name="languageComboBox"/>
           </item>
           <item>
            <widget class="QPushButton" name="updateLanguagesButton">
             <property name="text">
              <string>Update list</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="pathLabel">
         <property name="buddy">
          <cstring>tessdataPathEdit</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Tessdata path</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <layout class="QHBoxLayout" name="pathLayout" stretch="1,0">
           <item>
            <widget class="QLineEdit" name="tessdataPathEdit"/>
           </item>
           <item>
            <widget class="QPushButton" name="browseButton">
             <property name="text">
              <string>Browse</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="3" column="1">
          <widget class="QCheckBox" name="systemTessdataCheckBox">
           <property name="text">
            <string>Use system tessdata</string>
           </property>
          </widget>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="modeLabel">
         <property name="buddy">
          <cstring>autoRadio</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Processing mode</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <layout class="QHBoxLayout" name="modeLayout">
           <item>
            <widget class="QRadioButton" name="autoRadio">
             <property name="text">
              <string>Automatic</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="manualRadio">
             <property name="text">
              <string>Manual</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="5" column="0">
          <widget class="QLabel" name="intervalLabel">
         <property name="buddy">
          <cstring>intervalSpinBox</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Auto OCR interval (sec)</string>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="QSpinBox" name="intervalSpinBox">
           <property name="suffix">
            <string> sec</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>3600</number>
           </property>
          </widget>
         </item>
         <item row="6" column="1">
          <widget class="QLabel" name="applyHintLabel">
           <property name="text">
            <string>Settings above take effect after Apply, settings below apply immediately.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item row="7" column="1">
          <widget class="QCheckBox" name="skipUnchangedCheckBox">
           <property name="toolTip">
            <string>Reads a frame only when the picture changed and ignores results that
repeat the previous text. Fewer requests to the translator.</string>
           </property>
           <property name="text">
            <string>Skip unchanged frames and repeated text</string>
           </property>
          </widget>
         </item>
         <item row="8" column="0">
          <widget class="QLabel" name="sensitivityLabel">
         <property name="buddy">
          <cstring>sensitivitySlider</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Change sensitivity</string>
           </property>
          </widget>
         </item>
         <item row="8" column="1">
          <layout class="QHBoxLayout" name="sensitivityLayout">
           <item>
            <widget class="QSlider" name="sensitivitySlider">
             <property name="toolTip">
              <string>How much of the picture has to change before it is read again.
Higher reads more often, lower skips small changes.</string>
             </property>
             <property name="minimum">
              <number>0</number>
             </property>
             <property name="maximum">
              <number>100</number>
             </property>
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="sensitivityValueLabel">
             <property name="minimumSize">
              <size>
               <width>60</width>
               <height>0</height>
              </size>
             </property>
             <property name="text">
              <string notr="true">0</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="9" column="0">
          <widget class="QLabel" name="toleranceLabel">
         <property name="buddy">
          <cstring>toleranceSlider</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Ignore text differences</string>
           </property>
          </widget>
         </item>
         <item row="9" column="1">
          <layout class="QHBoxLayout" name="toleranceLayout">
           <item>
            <widget class="QSlider" name="toleranceSlider">
             <property name="toolTip">
              <string>A result that differs from the previous text by at most this many characters
is not sent on. Hides OCR flicker between similar results.</string>
             </property>
             <property name="minimum">
              <number>0</number>
             </property>
             <property name="maximum">
              <number>10</number>
             </property>
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="toleranceValueLabel">
             <property name="minimumSize">
              <size>
               <width>60</width>
               <height>0</height>
              </size>
             </property>
             <property name="text">
              <string notr="true">0</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="10" column="1">
          <widget class="QCheckBox" name="filterNoiseCheckBox">
           <property name="toolTip">
            <string>Drops low-confidence words and lines that do not look like text.</string>
           </property>
           <property name="text">
            <string>Filter out noise</string>
           </property>
          </widget>
         </item>
         <item row="11" column="0">
          <widget class="QLabel" name="confidenceLabel">
         <property name="buddy">
          <cstring>confidenceSlider</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Minimum word confidence</string>
           </property>
          </widget>
         </item>
         <item row="11" column="1">
          <layout class="QHBoxLayout" name="confidenceLayout">
           <item>
            <widget class="QSlider" name="confidenceSlider">
             <property name="toolTip">
              <string>Words Tesseract is less sure about than this are dropped as noise.
Higher removes more garbage but can lose stylized text.</string>
             </property>
             <property name="minimum">
              <number>0</number>
             </property>
             <property name="maximum">
              <number>80</number>
             </property>
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="confidenceValueLabel">
             <property name="minimumSize">
              <size>
               <width>60</width>
               <height>0</height>
              </size>
             </property>
             <property name="text">
              <string notr="true">0</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="12" column="0">
          <widget class="QLabel" name="psmLabel">
         <property name="buddy">
          <cstring>psmComboBox</cstring>
         </property>
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Text layout</string>
           </property>
          </widget>
         </item>
         <item row="12" column="1">
          <widget class="QComboBox" name="psmComboBox"/>
         </item>
         <item row="13" column="1">
          <widget class="QPushButton" name="resetButton">
           <property name="text">
            <string>Reset to defaults</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="settingsSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>0</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QGroupBox" name="previewGroupBox">
      <property name="minimumSize">
       <size>
        <width>300</width>
        <height>0</height>
       </size>
      </property>
      <property name="title">
       <string>Live preview</string>
      </property>
      <layout class="QGridLayout" name="previewLayout" rowstretch="0,0,0,0,0,0,3,0,2" columnstretch="1,0">
       <item row="0" column="0" colspan="2">
        <widget class="QLabel" name="previewHintLabel">
